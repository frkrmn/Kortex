# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Controlled-owner Gemini enrichment (server-only). Defaults to disabled.
# Free Tier use sends stored bookmark content to Google; enable only for the
# explicitly authorized owner. A rollout cap of 20 holds after Stage 1.
GEMINI_ENRICHMENT_ENABLED="false"
GEMINI_ENRICHMENT_FREE_TIER_CONFIRMED="false"
GEMINI_ENRICHMENT_OWNER_USER_ID=""
GEMINI_ENRICHMENT_ROLLOUT_CAP="0"
GEMINI_ENRICHMENT_BATCH_SIZE="5"
GEMINI_ENRICHMENT_CONCURRENCY="1"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Configuration
# Required for connecting to Supabase PostgreSQL database and Auth
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Server-only Supabase Service Role Key (NEVER expose to browser/client code)
SUPABASE_SERVICE_ROLE_KEY=""

# Mode Toggle: Set to 'true' to use local in-memory/demo fixtures, or 'false' for live Supabase
VITE_DEMO_MODE="true"

# X (Twitter) Developer App Credentials (OAuth 2.0 PKCE)
# Create an app at https://developer.x.com with OAuth 2.0 enabled
# Callback URL: <APP_URL>/api/integrations/x/callback
X_CLIENT_ID=""
X_CLIENT_SECRET=""

# Secret Encryption Key for AES-256-GCM token storage (REQUIRED, min 32 chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""

# Stable random salt for key derivation (required; changing it makes saved tokens unreadable)
ENCRYPTION_SALT=""

# AI Embedding Configuration
# text-embedding-004 produces 768-dimensional dense vectors
AI_EMBEDDING_MODEL="text-embedding-004"
AI_EMBEDDING_BATCH_SIZE="10"
AI_EMBEDDING_CONCURRENCY="2"

# Stripe Commercial Billing & Subscriptions
# Server-side Stripe API Secret Key (Keep secret, do NOT prefix with VITE_)
STRIPE_SECRET_KEY=""
# Stripe Webhook Signing Secret for authoritative event verification
STRIPE_WEBHOOK_SECRET=""
# Optional Client-Side Publishable Key
VITE_STRIPE_PUBLISHABLE_KEY=""
# Stripe Price IDs for Pro Tier
STRIPE_PRO_MONTHLY_PRICE_ID=""
STRIPE_PRO_YEARLY_PRICE_ID=""

# Import economics. Set explicit commercial values before enabling paid imports.
# Zero/blank means no automatic grant, pack, or X reads. Existing users get a separate configurable grant.
FREE_SIGNUP_IMPORT_CREDITS=""
EXISTING_USER_IMPORT_CREDITS=""
PRO_MONTHLY_IMPORT_CREDITS=""
PRO_TRIAL_IMPORT_CREDITS=""
IMPORT_500_CREDITS=""
IMPORT_1000_CREDITS=""
IMPORT_5000_CREDITS=""
STRIPE_IMPORT_500_PRICE_ID=""
STRIPE_IMPORT_1000_PRICE_ID=""
STRIPE_IMPORT_5000_PRICE_ID=""

# Internal estimated provider cost in your account currency. Confirm against your X agreement.
X_POST_READ_ESTIMATED_COST=""
X_PRICING_VERSION=""
X_API_MONTHLY_BUDGET=""
X_API_USER_MONTHLY_BUDGET=""
# Server-only comma-separated allowlist for controlled real-X validation.
# Never prefix with VITE_. Empty means nobody bypasses provider-budget preflight.
X_E2E_TEST_USER_EMAILS=""
X_API_WARNING_THRESHOLD_PERCENT="80"
X_API_HARD_LIMIT_PERCENT="100"
X_API_FREE_MANUAL_STOP_PERCENT="80"
X_API_AUTOMATIC_STOP_PERCENT="90"
X_API_OPPORTUNISTIC_STOP_PERCENT="70"
X_SYNC_INITIAL_PAGE_SIZE="20"
X_SYNC_INCREMENTAL_PAGE_SIZE="10"
X_SYNC_MAX_PAGES_PER_RUN="3"
# Product safeguard: the official bookmark reference currently documents paging,
# but no total historical ceiling. Keep this conservative until X publishes one.
X_BOOKMARK_HISTORY_LIMIT="800"
X_SMART_SYNC_DAILY_BATCH_SIZE="3"

# Phase 12: Background Automation, Cron & Email Delivery
# Resend API Key for digest emails (https://resend.com)
RESEND_API_KEY=""
# From address for outgoing emails (e.g. "Recallly <digests@recallly.app>")
EMAIL_FROM="Recallly <digests@recallly.app>"

# Secret token protecting external cron webhook endpoints (/api/cron/*)
CRON_SECRET=""

# Operational Killswitches & Maintenance Toggles (true/false)
X_AUTO_SYNC_ENABLED="false"
X_SYNC_ENABLED="true"
AI_PROCESSING_ENABLED="true"
DIGEST_GENERATION_ENABLED="true"
EMAIL_DELIVERY_ENABLED="true"
