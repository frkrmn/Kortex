# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Configuration
# Required for connecting to Supabase PostgreSQL database and Auth
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Server-only Supabase Service Role Key (NEVER expose to browser/client code)
SUPABASE_SERVICE_ROLE_KEY=""

# Mode Toggle: Set to 'true' to use local in-memory/demo fixtures, or 'false' for live Supabase
VITE_DEMO_MODE="true"

# X (Twitter) Developer App Credentials (OAuth 2.0 PKCE)
# Create an app at https://developer.x.com with OAuth 2.0 enabled
# Callback URL: <APP_URL>/api/integrations/x/callback
X_CLIENT_ID=""
X_CLIENT_SECRET=""

# Secret Encryption Key for AES-256-GCM token storage (REQUIRED, min 32 chars)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=""

# Salt for key derivation (optional, random per startup if not set)
ENCRYPTION_SALT=""

# AI Embedding Configuration
# text-embedding-004 produces 768-dimensional dense vectors
AI_EMBEDDING_MODEL="text-embedding-004"
AI_EMBEDDING_BATCH_SIZE="10"
AI_EMBEDDING_CONCURRENCY="2"

# Stripe Commercial Billing & Subscriptions
# Server-side Stripe API Secret Key (Keep secret, do NOT prefix with VITE_)
STRIPE_SECRET_KEY=""
# Stripe Webhook Signing Secret for authoritative event verification
STRIPE_WEBHOOK_SECRET=""
# Optional Client-Side Publishable Key
VITE_STRIPE_PUBLISHABLE_KEY=""
# Stripe Price IDs for Pro Tier
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_YEARLY=""

# Phase 12: Background Automation, Cron & Email Delivery
# Resend API Key for digest emails (https://resend.com)
RESEND_API_KEY=""
# From address for outgoing emails (e.g. "Recallly <digests@recallly.app>")
EMAIL_FROM="Recallly <digests@recallly.app>"

# Secret token protecting external cron webhook endpoints (/api/cron/*)
CRON_SECRET=""

# Operational Killswitches & Maintenance Toggles (true/false)
X_SYNC_ENABLED="true"
AI_PROCESSING_ENABLED="true"
DIGEST_GENERATION_ENABLED="true"
EMAIL_DELIVERY_ENABLED="true"

